{
  "name": "qatool-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx apps/cli/src/index.ts",
    "test": "tsx apps/cli/src/index.ts run --suite=./tests",
    "test:parallel": "tsx apps/cli/src/index.ts run --suite=./tests --parallel=3 --retries=2",
    "test:load": "tsx apps/cli/src/index.ts load --url=https://reqres.in/api/users --count=20 --concurrency=5",
    "dashboard": "npm run dev --workspace=apps/dashboard",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3",
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
